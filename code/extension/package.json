{
  "name": "meridian-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:verify": "node scripts/prepare-assets.mjs --verify",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch",
    "build": "npm run assets:verify && npm run typecheck && vite build",
    "test": "npm run test:offline",
    "test:offline": "npm run build && playwright test",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.1.37",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
