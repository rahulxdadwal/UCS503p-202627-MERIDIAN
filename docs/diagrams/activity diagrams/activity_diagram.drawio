        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\n\n%%{init: {\&quot;theme\&quot;: \&quot;base\&quot;, \&quot;flowchart\&quot;: {\&quot;nodeSpacing\&quot;: 35, \&quot;rankSpacing\&quot;: 45, \&quot;curve\&quot;: \&quot;linear\&quot;}}}%%\nflowchart LR\n\n    subgraph COL1[\&quot;1. SOURCE SELECTION\&quot;]\n        direction TB\n\n        START((Start))\n        OPEN[\&quot;Open Meridian\&quot;]\n        LOAD[\&quot;Create or load&lt;br/&gt;local workspace\&quot;]\n        S1((S))\n        SOURCE{\&quot;Select artifact source\&quot;}\n\n        TAB[\&quot;Capture active tab&lt;br/&gt;and page metadata\&quot;]\n        PDF[\&quot;Import local PDF\&quot;]\n        NOTE[\&quot;Import Markdown note\&quot;]\n        SNIPPET[\&quot;Add code snippet\&quot;]\n\n        A1((A))\n\n        START --&gt; OPEN --&gt; LOAD --&gt; S1 --&gt; SOURCE\n\n        SOURCE --&gt;|Active tab| TAB\n        SOURCE --&gt;|PDF| PDF\n        SOURCE --&gt;|Markdown| NOTE\n        SOURCE --&gt;|Code| SNIPPET\n\n        TAB --&gt; A1\n        PDF --&gt; A1\n        NOTE --&gt; A1\n        SNIPPET --&gt; A1\n    end\n\n    subgraph COL2[\&quot;2. CONTENT PREPARATION\&quot;]\n        direction TB\n\n        A2((A))\n        VALID{\&quot;Content valid&lt;br/&gt;and readable?\&quot;}\n\n        SOURCE_ERROR[\&quot;Display source or&lt;br/&gt;permission error\&quot;]\n        RETRY_SOURCE{\&quot;Try another source?\&quot;}\n        S2((S))\n        SOURCE_END((End))\n\n        CLEAN[\&quot;Clean and structure&lt;br/&gt;extracted content\&quot;]\n        MODE{\&quot;Select indexing mode\&quot;}\n\n        PAGE[\&quot;Page Mode&lt;br/&gt;Create lightweight&lt;br/&gt;content blocks\&quot;]\n\n        DEEP[\&quot;Deep Focus Mode&lt;br/&gt;Preserve headings, code and tables&lt;br/&gt;Create 256-token chunks&lt;br/&gt;with 50-token overlap\&quot;]\n\n        B1((B))\n\n        A2 --&gt; VALID\n\n        VALID --&gt;|No| SOURCE_ERROR\n        SOURCE_ERROR --&gt; RETRY_SOURCE\n        RETRY_SOURCE --&gt;|Yes| S2\n        RETRY_SOURCE --&gt;|No| SOURCE_END\n\n        VALID --&gt;|Yes| CLEAN --&gt; MODE\n\n        MODE --&gt;|Page Mode| PAGE\n        MODE --&gt;|Deep Focus| DEEP\n\n        PAGE --&gt; B1\n        DEEP --&gt; B1\n    end\n\n    subgraph COL3[\&quot;3. VECTOR GENERATION\&quot;]\n        direction TB\n\n        B2((B))\n        E1((E))\n\n        EMBED[\&quot;Generate 384-dimensional&lt;br/&gt;embeddings locally\&quot;]\n\n        EMBED_OK{\&quot;Embedding successful?\&quot;}\n\n        INDEX_ERROR[\&quot;Mark artifact as failed&lt;br/&gt;and display error\&quot;]\n\n        RETRY_INDEX{\&quot;Retry indexing?\&quot;}\n\n        E2((E))\n        INDEX_END((End))\n\n        QUANTIZE[\&quot;SQ8-quantize&lt;br/&gt;generated vectors\&quot;]\n\n        C1((C))\n\n        B2 --&gt; E1 --&gt; EMBED --&gt; EMBED_OK\n\n        EMBED_OK --&gt;|No| INDEX_ERROR\n        INDEX_ERROR --&gt; RETRY_INDEX\n        RETRY_INDEX --&gt;|Yes| E2\n        RETRY_INDEX --&gt;|No| INDEX_END\n\n        EMBED_OK --&gt;|Yes| QUANTIZE --&gt; C1\n    end\n\n    subgraph COL4[\&quot;4. STORAGE AND CANVAS\&quot;]\n        direction TB\n\n        C2((C))\n        FORK[\&quot; \&quot;]\n\n        IDB[\&quot;Store metadata and&lt;br/&gt;SQ8 vectors in IndexedDB\&quot;]\n\n        OPFS[\&quot;Store available&lt;br/&gt;thumbnail in OPFS\&quot;]\n\n        JOIN[\&quot; \&quot;]\n\n        LAYOUT[\&quot;Calculate semantic cluster&lt;br/&gt;and 2D canvas position\&quot;]\n\n        RENDER[\&quot;Display artifact card&lt;br/&gt;on knowledge map\&quot;]\n\n        D1((D))\n\n        C2 --&gt; FORK\n\n        FORK --&gt; IDB\n        FORK --&gt; OPFS\n\n        IDB --&gt; JOIN\n        OPFS --&gt; JOIN\n\n        JOIN --&gt; LAYOUT --&gt; RENDER --&gt; D1\n    end\n\n    subgraph COL5[\&quot;5. USER ACTIONS\&quot;]\n        direction TB\n\n        D2((D))\n        M1((M))\n        ACTION{\&quot;Choose next action\&quot;}\n\n        ADD_DECISION{\&quot;Add another artifact?\&quot;}\n        ADD[\&quot;Return to source selection\&quot;]\n        S3((S))\n\n        EXPLORE_DECISION{\&quot;Explore canvas?\&quot;}\n        EXPLORE[\&quot;Pan, zoom, reposition,&lt;br/&gt;pin or inspect cards\&quot;]\n\n        SEARCH_DECISION{\&quot;Search workspace?\&quot;}\n        QUERY[\&quot;Enter natural-language&lt;br/&gt;search query\&quot;]\n        SEARCH[\&quot;Embed query and calculate&lt;br/&gt;cosine similarity\&quot;]\n        MATCH{\&quot;Relevant matches found?\&quot;}\n        NO_MATCH[\&quot;Display no matching&lt;br/&gt;artifact message\&quot;]\n        PAN[\&quot;Rank Top-K matches and&lt;br/&gt;calculate cluster centroid\&quot;]\n        INSPECT[\&quot;Auto-pan to cluster&lt;br/&gt;and inspect result\&quot;]\n\n        EXPORT_DECISION{\&quot;Export workspace?\&quot;}\n        EXPORT[\&quot;Package coordinates,&lt;br/&gt;metadata and vectors\&quot;]\n        SAVE[\&quot;Save standalone&lt;br/&gt;HTML or JSON export\&quot;]\n\n        M2((M))\n        END((End))\n\n        D2 --&gt; M1 --&gt; ACTION\n\n        ACTION --&gt; ADD_DECISION\n\n        ADD_DECISION --&gt;|Yes| ADD --&gt; S3\n        ADD_DECISION --&gt;|No| EXPLORE_DECISION\n\n        EXPLORE_DECISION --&gt;|Yes| EXPLORE --&gt; M2\n        EXPLORE_DECISION --&gt;|No| SEARCH_DECISION\n\n        SEARCH_DECISION --&gt;|Yes| QUERY\n        QUERY --&gt; SEARCH --&gt; MATCH\n        MATCH --&gt;|No| NO_MATCH --&gt; M2\n        MATCH --&gt;|Yes| PAN --&gt; INSPECT --&gt; M2\n\n        SEARCH_DECISION --&gt;|No| EXPORT_DECISION\n\n        EXPORT_DECISION --&gt;|Yes| EXPORT\n        EXPORT --&gt; SAVE --&gt; M2\n\n        EXPORT_DECISION --&gt;|No| END\n    end\n\n    COL1 ~~~ COL2\n    COL2 ~~~ COL3\n    COL3 ~~~ COL4\n    COL4 ~~~ COL5\n\n    classDef startEnd fill:#111827,stroke:#f97316,stroke-width:3px,color:#ffffff\n    classDef activity fill:#dbeafe,stroke:#2563eb,stroke-width:1.5px,color:#0f172a\n    classDef decision fill:#eff6ff,stroke:#2563eb,stroke-width:1.5px,color:#0f172a\n    classDef errorNode fill:#fee2e2,stroke:#dc2626,stroke-width:1.5px,color:#7f1d1d\n    classDef storageNode fill:#ede9fe,stroke:#7c3aed,stroke-width:1.5px,color:#2e1065\n    classDef searchNode fill:#dcfce7,stroke:#16a34a,stroke-width:1.5px,color:#14532d\n    classDef exportNode fill:#fef3c7,stroke:#d97706,stroke-width:1.5px,color:#78350f\n    classDef connector fill:#ffffff,stroke:#f97316,stroke-width:2.5px,color:#9a3412\n    classDef forkJoin fill:#111827,stroke:#111827,stroke-width:4px,color:#111827\n\n    class START,SOURCE_END,INDEX_END,END startEnd\n\n    class OPEN,LOAD,TAB,PDF,NOTE,SNIPPET,CLEAN,PAGE,DEEP,EMBED,QUANTIZE,LAYOUT,RENDER,ADD,EXPLORE activity\n\n    class SOURCE,VALID,RETRY_SOURCE,MODE,EMBED_OK,RETRY_INDEX,ACTION,ADD_DECISION,EXPLORE_DECISION,SEARCH_DECISION,MATCH,EXPORT_DECISION decision\n\n    class SOURCE_ERROR,INDEX_ERROR errorNode\n    class IDB,OPFS storageNode\n    class QUERY,SEARCH,NO_MATCH,PAN,INSPECT searchNode\n    class EXPORT,SAVE exportNode\n\n    class S1,S2,S3,A1,A2,B1,B2,C1,C2,D1,D2,E1,E2,M1,M2 connector\n    class FORK,JOIN forkJoin\n\n    style COL1 fill:#f8fafc,stroke:#94a3b8,stroke-width:2px\n    style COL2 fill:#f8fafc,stroke:#94a3b8,stroke-width:2px\n    style COL3 fill:#f8fafc,stroke:#94a3b8,stroke-width:2px\n    style COL4 fill:#f8fafc,stroke:#94a3b8,stroke-width:2px\n    style COL5 fill:#f8fafc,stroke:#94a3b8,stroke-width:2px\n\n    linkStyle default stroke:#f97316,stroke-width:1.5px\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="MRRBhgyge6kuGe2H8Qvx-212">
